{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "env": {
    "NLT_OTOI_VERSION": "NLT-PI-DEV-OTOI-1.0.0",
    "NLT_AUTHORITY": "Joshua W. Dorsey, Sr.",
    "NLT_GOVERNANCE_SOURCE": "NeuroLift-Technologies/.github-private",
    "NLT_GOVERNANCE_MODE": "repository-adapted"
  }
}
