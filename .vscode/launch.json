{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pi: Print Mode",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "args": [
        "--tsconfig",
        "${workspaceFolder}/tsconfig.json",
        "${workspaceFolder}/packages/coding-agent/src/cli.ts",
        "--provider",
        "azure-openai-completions",
        "--model",
        "gpt-5.4",
        "-p",
        "Summarize the current repository structure"
      ],
      "env": {
        "AZURE_OPENAI_API_KEY": "xK3CR5gN1u6azwpEZNdsLOnYv2mTmvkP_GPT_AK",
        "AZURE_OPENAI_BASE_URL": "https://aidp.bytedance.net/api/modelhub/online/v2/crawl",
        "AZURE_OPENAI_DEPLOYMENT_NAME_MAP": "gpt-5.4-2026-03-05"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Pi: Interactive",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "args": [
        "--tsconfig",
        "${workspaceFolder}/tsconfig.json",
        "${workspaceFolder}/packages/coding-agent/src/cli.ts",
        "--provider",
        "azure-openai-responses",
        "--model",
        "gpt-5.4-2026-03-05"
      ],
      "env": {
        "AZURE_OPENAI_API_KEY": "${env:AZURE_OPENAI_API_KEY}",
        "AZURE_OPENAI_BASE_URL": "${env:AZURE_OPENAI_BASE_URL}",
        "AZURE_OPENAI_DEPLOYMENT_NAME_MAP": "${env:AZURE_OPENAI_DEPLOYMENT_NAME_MAP}"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Pi: No Env Print",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "args": [
        "--tsconfig",
        "${workspaceFolder}/tsconfig.json",
        "${workspaceFolder}/packages/coding-agent/src/cli.ts",
        "--provider",
        "azure-openai-responses",
        "--model",
        "gpt-5.4-2026-03-05",
        "-p",
        "Hello from debugger"
      ],
      "env": {
