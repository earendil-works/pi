        "MINIMAX_API_KEY": "",
        "MINIMAX_CN_API_KEY": "",
        "AI_GATEWAY_API_KEY": "",
        "OPENCODE_API_KEY": "",
        "COPILOT_GITHUB_TOKEN": "",
        "GH_TOKEN": "",
        "GITHUB_TOKEN": "",
