{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"customConditions": ["source"]
	},
	"include": [
		"src/**/*.ts",
		"src/api/v1/css.d.ts",
		"src/**/*.tsx",
		"plugins/**/*.ts",
		"plugins/**/*.tsx",
		"test/**/*.ts",
		"test/**/*.tsx",
		"bench/**/*.ts",
		"scripts/**/*.ts"
	]
}
