{
	"name": "p2",
	"version": "0.0.3",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "node --import ./src/source.ts src/hosts/server.ts",
		"dev": "node --import ./src/source.ts scripts/dev.mjs",
		"reload": "node --import ./src/source.ts scripts/reload.mjs",
		"owner-link": "node --import ./src/source.ts scripts/owner-link.ts",
		"migrate-data": "node --import ./src/source.ts scripts/migrate-data.ts",
		"radius:login": "node --import ./src/source.ts plugins/radius/login.ts",
		"check": "node ../../scripts/biome-check.mjs && tsc --noEmit",
		"format": "node ../../scripts/biome-check.mjs --write",
		"test": "node --import ./src/source.ts --test --test-concurrency=1 test/**/*.test.ts",
		"tui": "node --import ./src/source.ts src/hosts/tui.ts"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/chord": "1.5.2",
		"@earendil-works/design-tokens": "0.1.0",
		"@earendil-works/elanor-fonts": "0.1.0",
		"@earendil-works/elanor-icons-react": "0.1.0",
		"@earendil-works/elanor-react": "0.1.0",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-codemode": "1.5.2",
		"@earendil-works/pi-durable": "1.5.2",
		"@earendil-works/pi-env": "1.5.2",
		"@earendil-works/pi-mcp": "1.5.2",
		"@earendil-works/pi-schema": "1.5.2",
		"@earendil-works/pi-tui": "1.5.2",
		"articulated": "1.4.0",
		"diff": "8.0.4",
		"discord.js": "14.28.1",
		"esbuild": "0.28.2",
		"grok-mermaid": "0.2.3",
		"lowlight": "3.3.0",
		"marked": "18.0.14",
		"proper-lockfile": "4.1.2",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"undici": "8.12.3",
		"ws": "8.21.0",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "4.1.4",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/ws": "8.18.2",
		"typescript": "5.9.3"
	}
}
