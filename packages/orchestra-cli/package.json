{
	"name": "@earendil-works/pi-orchestra-cli",
	"version": "1.5.0",
	"description": "Orchestra CLI: up/status/goal/spawn/escalations",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": { "orchestra": "dist/cli.js" },
	"exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./package.json": "./package.json" },
	"files": ["dist"],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json && node ../../scripts/package-files.mjs executable dist/cli.js",
		"test": "vitest --run"
	},
	"engines": { "node": ">=22.19.0" },
	"devDependencies": { "@types/node": "22.19.19", "vitest": "4.1.12" },
	"dependencies": { "@earendil-works/pi-orchestra-core": "1.5.0", "@earendil-works/pi-orchestra-supervisor": "1.5.0" }
}
