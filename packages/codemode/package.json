{
	"name": "@earendil-works/pi-codemode",
	"version": "1.6.0",
	"description": "Sandboxed JavaScript and TypeScript execution where the only capability is calling injected tools",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./declarations": {
			"source": "./src/declarations.ts",
			"types": "./dist/declarations.d.ts",
			"import": "./dist/declarations.js"
		},
		"./source": {
			"source": "./src/source.ts",
			"types": "./dist/source.d.ts",
			"import": "./dist/source.js"
		},
		"./portable": {
			"source": "./src/portable.ts",
			"types": "./dist/portable.d.ts",
			"import": "./dist/portable.js"
		},
		"./cloudflare": {
			"source": "./src/cloudflare.ts",
			"types": "./dist/cloudflare.d.ts",
			"import": "./dist/cloudflare.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"pi",
		"codemode",
		"sandbox",
		"djs",
		"typescript",
		"wasm",
		"cloudflare",
		"durable-objects"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/codemode"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/djs": "file:../../vendor/earendil-works-djs-0.3.0-dev.1.tgz"
	},
	"devDependencies": {
		"vitest": "4.1.12"
	}
}
