// Type-checks the example extensions against the modules extensions see at run time (core/extensions/virtual-modules.ts):
// "@earendil-works/pi-ai" is the extension view, which adds TypeBox's Type, Static and TSchema to the compat entry (the
// view imports "@earendil-works/pi-ai/compat", so that path stays the package's own).
// The other paths repeat the root tsconfig.json; keep them in sync.
// Also the test that imports the subagent example: it type-checks only against the extension view.
{
	"extends": "../../../tsconfig.json",
	"compilerOptions": {
		"paths": {
			"@earendil-works/pi-ai": [
				"../../../packages/coding-agent/src/core/extensions/pi-ai-extension-view.ts"
			],
			"@earendil-works/pi-ai/oauth": [
				"../../../packages/ai/src/oauth.ts"
			],
			"@earendil-works/pi-ai/*": [
				"../../../packages/ai/src/*.ts",
				"../../../packages/ai/src/providers/*.ts"
			],
			"@earendil-works/pi-ai/dist/*": [
				"../../../packages/ai/src/*"
			],
			"@earendil-works/pi-agent-core": [
				"../../../packages/agent/src/index.ts"
			],
			"@earendil-works/pi-coding-agent": [
				"../../../packages/coding-agent/src/index.ts"
			],
			"@earendil-works/pi-coding-agent/hooks": [
				"../../../packages/coding-agent/src/core/hooks/index.ts"
			],
			"@earendil-works/pi-coding-agent/*": [
				"../../../packages/coding-agent/src/*"
			],
			"typebox": [
				"../../../node_modules/typebox"
			],
			"@earendil-works/pi-tui": [
				"../../../packages/tui/src/index.ts"
			],
			"@earendil-works/pi-tui/*": [
				"../../../packages/tui/src/*"
			],
			"@mariozechner/pi-ai": [
				"../../../packages/coding-agent/src/core/extensions/pi-ai-extension-view.ts"
			]
		}
	},
	"include": [
		"./extensions/**/*",
		"../../*/src/**/*.d.ts",
		"../test/suite/regressions/8261-subagent-project-trust.test.ts"
	],
	"exclude": [
		"**/node_modules/**",
		"./extensions/gondolin/**"
	]
}
