{
	"name": "@kennyfrc/mu-coding-agent",
	"version": "0.24.117",
	"description": "Coding agent CLI with read, bash, edit, write tools and session management",
	"type": "module",
	"bin": {
		"mu": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && chmod +x dist/cli.js && npm run copy-theme-assets",
		"copy-theme-assets": "cp src/theme/*.json dist/theme/ && mkdir -p dist/prompts && cp src/prompts/*.yaml dist/prompts/",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"start": "npx tsx src/cli.ts",
		"check": "tsgo --noEmit",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@kennyfrc/mu-agent-core": "^0.24.117",
		"@kennyfrc/mu-ai": "^0.24.117",
		"@kennyfrc/mu-tui": "^0.24.117",
		"better-sqlite3": "^12.6.2",
		"chalk": "^5.5.0",
		"diff": "^8.0.2",
		"glob": "^11.0.3",
		"jiti": "^2.6.1",
		"yaml": "^2.8.2"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/diff": "^7.0.2",
		"@types/node": "^24.3.0",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kennyfrc/mu-mono.git",
		"directory": "packages/coding-agent"
	},
	"publishConfig": {
		"access": "restricted"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
