{
	"name": "@earendil-works/pi-evals",
	"version": "1.5.2",
	"private": true,
	"type": "module",
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean .eval",
		"eval": "npm run eval:host && npm run eval:docs --",
		"eval:host": "vitest run --config vitest.evals.config.ts --project host",
		"eval:audit": "vitest run --config vitest.evals.config.ts --project audit",
		"eval:docs": "node --experimental-strip-types src/cli.ts",
		"test": "vitest run --config vitest.test.config.ts"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@types/node": "22.19.19",
		"@vitest-evals/core": "0.15.0",
		"vitest": "4.1.12",
		"vitest-evals": "0.15.0"
	}
}
