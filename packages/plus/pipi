#!/usr/bin/env bash
# Run pi from sources with the packages/plus override layer active.
# Same args as ./pi-test.sh, including --no-env.
# Uses Node's native type stripping (no tsx); the plus resolve hook maps workspace
# packages to sources and redirects overridden modules to packages/plus wrappers.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

exec node "$REPO_ROOT/packages/plus/loader/run-plus.mjs" "$@"
