{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./server",
    "lib": ["ES2022", "DOM"]
  },
  "include": ["server/**/*.ts", "web/src/**/*.ts", "web/src/**/*.tsx"]
}
