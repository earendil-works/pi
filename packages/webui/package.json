{
  "name": "@pi-mono/webui",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "dev:webui": "bash scripts/dev-webui.sh",
    "build:web": "cd web && npm run build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.bundle.js --external:express --external:ws --external:helmet --external:chokidar --external:async-mutex --external:cross-spawn --external:node:sqlite --external:bun:sqlite --external:vite --external:better-sqlite3 --external:sqlite-vec",
    "build": "npm run build:web && npm run build:server",
    "test": "vitest"
  },
  "dependencies": {
    "async-mutex": "0.5.0",
    "chokidar": "3.6.0",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/ws": "8.5.13",
    "@vitest/coverage-v8": "2.1.8",
    "esbuild": "0.24.2",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "2.1.8"
  }
}
