{
	"name": "@earendil-works/pi-schema",
	"version": "1.5.1",
	"description": "JSON Schema validation without eval: drafts 2020-12 and 7, compiled into plain closures",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./formats": {
			"source": "./src/formats/index.ts",
			"types": "./dist/formats/index.d.ts",
			"import": "./dist/formats/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"THIRD_PARTY_NOTICES"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"bench": "node --expose-gc test/bench/all.ts",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"json-schema",
		"validation",
		"validator",
		"csp"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/schema"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@cfworker/json-schema": "4.1.1",
		"@oh-my-pi/omptype": "18.13.3",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"ata-validator": "1.61.3",
		"typebox": "1.3.27",
		"vitest": "4.1.12",
		"zod": "4.6.7"
	}
}
